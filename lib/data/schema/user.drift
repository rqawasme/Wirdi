-- user.db — read-write, in the app documents directory so that iOS iCloud
-- backup and Android Auto Backup pick it up. That is the whole backup story:
-- there is no sync and no server.
--
-- Never replaced, only migrated. content.db is the one that gets swapped out.
--
-- Ids are UUID v4 TEXT, not autoincrement integers, and every row carries
-- updated_at (epoch milliseconds, UTC). Both cost nothing now and are what
-- make export, sharing or any future sync possible without a painful
-- migration.
--
-- Rows reference content.db by id. There are no cross-database foreign keys
-- and no ATTACH; resolution happens in Dart.
--
-- One kind of row does not reference content.db at all: an item can point at a
-- dhikr the user wrote, which lives in `user_adhkar` in this same database. See
-- the note on `user_collection_items.user_item_id`.

CREATE TABLE user_collections (
    id          TEXT    NOT NULL PRIMARY KEY,
    name        TEXT    NOT NULL,
    description TEXT,
    sort_order  INTEGER NOT NULL,
    created_at  INTEGER NOT NULL,
    updated_at  INTEGER NOT NULL,
    deleted_at  INTEGER
) AS UserCollectionRow;

CREATE TABLE user_collection_items (
    id                 TEXT    NOT NULL PRIMARY KEY,
    collection_id      TEXT    NOT NULL REFERENCES user_collections (id),
    -- 'dhikr' | 'ayah' | 'surah', referencing content.db by item_id; or
    -- 'user_dhikr', referencing user_adhkar by user_item_id.
    item_type          TEXT    NOT NULL,
    item_id            INTEGER NOT NULL,
    position           INTEGER NOT NULL,
    count_override     INTEGER,
    repeat_group       INTEGER,
    repeat_group_count INTEGER,
    -- A rubric shown with this item, mirroring collection_items.note. A user
    -- collection copied from a built-in keeps the built-in's notes.
    note               TEXT,
    -- Set on a 'user_dhikr' row and null on every other: `user_adhkar.id`, the
    -- UUID of a dhikr the user wrote.
    --
    -- A second column rather than a wider `item_id`, because `item_id` is
    -- INTEGER NOT NULL and widening it to TEXT means rebuilding this table —
    -- and a table rebuild is the one migration step that cannot be made
    -- idempotent, which is the rule every step in the ladder has to keep. See
    -- the note on onUpgrade in user_database.dart.
    --
    -- A 'user_dhikr' row carries `item_id` 0, which is not a valid id in any of
    -- the three content spaces — surah numbers and dhikr ids start at 1, and
    -- ayahs.id is surah * 1000 + ayah — so a row that names no content row
    -- reads as one.
    user_item_id       TEXT,
    updated_at         INTEGER NOT NULL
) AS UserCollectionItemRow;

CREATE INDEX IF NOT EXISTS idx_user_collection_items_position
    ON user_collection_items (collection_id, position);

-- What `user_adhkar` deletion and the "used in" count are read through: which
-- items point at one dhikr, across every collection. Sparse in effect — only
-- 'user_dhikr' rows carry the column.
CREATE INDEX IF NOT EXISTS idx_user_collection_items_user_item
    ON user_collection_items (user_item_id);

-- Adhkar the user wrote themselves.
--
-- A collection item points at one of these exactly the way it points at a
-- built-in dhikr; what differs is only which database holds the row and so
-- what kind of id names it. `content.db` is replaced wholesale on an app
-- update, which is the reason a dhikr somebody wrote cannot live there.
--
-- `translation` is nullable where `adhkar.translation` in content.db is not. A
-- built-in is authored with one by a pipeline that can insist; somebody
-- writing down the dua they say after Fajr already knows what it means, and
-- refusing to save it until they have typed a translation is asking them to do
-- the content build's job.
--
-- `reference` is free text — a hadith collection and a number, a book and a
-- page — and deliberately not a foreign key into content.db's `sources`. A
-- source row carries a grading, which is a scholarly claim made by the
-- pipeline; what somebody types about where they found a dua is a note about
-- their own copy. Storing it as one keeps the app from presenting the second
-- as the first.
--
-- Soft delete, like user_collections: `deleted_at` is set and the row stays.
-- Unlike a collection, deleting one also takes its items out of the
-- collections that held it — see `deleteItemsForUserDhikr`.
CREATE TABLE user_adhkar (
    id              TEXT    NOT NULL PRIMARY KEY,
    text_arabic     TEXT    NOT NULL,
    translation     TEXT,
    transliteration TEXT,
    default_count   INTEGER NOT NULL DEFAULT 1,
    reference       TEXT,
    notes           TEXT,
    created_at      INTEGER NOT NULL,
    updated_at      INTEGER NOT NULL,
    deleted_at      INTEGER
) AS UserDhikrRow;

-- collection_ref is CollectionId.canonical: 'b:12' or 'u:<uuid>'.
--
-- step_index indexes ResolvedCollection.steps, the flattened playback list, so
-- a position inside a repeat block is expressible. step_ref is the
-- ContentRef.canonical of the step that index pointed at when it was written:
-- on resume, a step_ref that no longer matches means a content update or a
-- reorder moved things underneath, and the progress is discarded rather than
-- resumed at the wrong dhikr.
--
-- unit_index is how far into the current repetition the reciter is, in the
-- units that step is made of: the ayah of a surah being read one verse at a
-- time, and 0 for every step whose unit is the whole item. It defaults to 0 so
-- a row written before this column existed comes forward as the start of its
-- repetition, which is where a step with one unit always is.
CREATE TABLE progress (
    collection_ref TEXT    NOT NULL PRIMARY KEY,
    step_index     INTEGER NOT NULL,
    step_ref       TEXT    NOT NULL,
    current_count  INTEGER NOT NULL,
    unit_index     INTEGER NOT NULL DEFAULT 0,
    updated_at     INTEGER NOT NULL
) AS ProgressRow;

-- date_key is YYYY-MM-DD in local time, denormalised deliberately: streak
-- queries run against it constantly, and deriving local dates from timestamps
-- at query time is slow and breaks when the user changes timezone.
CREATE TABLE completions (
    id             TEXT    NOT NULL PRIMARY KEY,
    collection_ref TEXT    NOT NULL,
    date_key       TEXT    NOT NULL,
    completed_at   INTEGER NOT NULL
) AS CompletionRow;

CREATE UNIQUE INDEX IF NOT EXISTS idx_completions_ref_date
    ON completions (collection_ref, date_key);
CREATE INDEX IF NOT EXISTS idx_completions_date ON completions (date_key);

-- Single row by construction.
CREATE TABLE reading_position (
    id           INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    surah_number INTEGER NOT NULL,
    ayah_number  INTEGER NOT NULL,
    updated_at   INTEGER NOT NULL
) AS ReadingPositionRow;

CREATE TABLE settings (
    "key"      TEXT    NOT NULL PRIMARY KEY,
    value      TEXT    NOT NULL,
    updated_at INTEGER NOT NULL
) AS SettingRow;

-- ---------------------------------------------------------------------------
-- Collections
-- ---------------------------------------------------------------------------

activeUserCollections:
    SELECT * FROM user_collections
    WHERE deleted_at IS NULL
    ORDER BY sort_order, created_at, id;

activeUserCollection:
    SELECT * FROM user_collections WHERE id = :id AND deleted_at IS NULL;

nextUserCollectionSortOrder:
    SELECT COALESCE(MAX(sort_order), 0) + 1 AS v FROM user_collections;

insertUserCollection:
    INSERT INTO user_collections
        (id, name, description, sort_order, created_at, updated_at, deleted_at)
    VALUES (:id, :name, :description, :sortOrder, :createdAt, :updatedAt, NULL);

-- Name and description together, in one statement. The form asks both questions at
-- once, and a half-applied answer — a renamed collection carrying the description of
-- what it used to be — is worse than a refused one.
--
-- NULL clears the description. A description somebody emptied is a description they
-- removed, and the form hands back null for an empty field.
updateUserCollectionDetails:
    UPDATE user_collections
    SET name = :name, description = :description, updated_at = :updatedAt
    WHERE id = :id AND deleted_at IS NULL;

softDeleteUserCollection:
    UPDATE user_collections
    SET deleted_at = :deletedAt, updated_at = :deletedAt
    WHERE id = :id AND deleted_at IS NULL;

-- ---------------------------------------------------------------------------
-- Collection items
-- ---------------------------------------------------------------------------

itemsForUserCollection:
    SELECT * FROM user_collection_items
    WHERE collection_id = :collection
    ORDER BY position;

nextItemPosition:
    SELECT COALESCE(MAX(position), 0) + 1 AS v
    FROM user_collection_items WHERE collection_id = :collection;

insertUserCollectionItem:
    INSERT INTO user_collection_items
        (id, collection_id, item_type, item_id, position, count_override,
         repeat_group, repeat_group_count, note, user_item_id, updated_at)
    VALUES (:id, :collection, :itemType, :itemId, :position, :countOverride,
            :repeatGroup, :repeatGroupCount, :note, :userItemId, :updatedAt);

deleteUserCollectionItem:
    DELETE FROM user_collection_items
    WHERE id = :id AND collection_id = :collection;

setItemPosition:
    UPDATE user_collection_items
    SET position = :position, updated_at = :updatedAt
    WHERE id = :id AND collection_id = :collection;

nextRepeatGroup:
    SELECT COALESCE(MAX(repeat_group), 0) + 1 AS v
    FROM user_collection_items WHERE collection_id = :collection;

setItemRepeatGroup:
    UPDATE user_collection_items
    SET repeat_group = :group, repeat_group_count = :count,
        updated_at = :updatedAt
    WHERE id = :id AND collection_id = :collection;

clearItemsRepeatGroup:
    UPDATE user_collection_items
    SET repeat_group = NULL, repeat_group_count = NULL, updated_at = :updatedAt
    WHERE collection_id = :collection AND repeat_group = :group;

-- ---------------------------------------------------------------------------
-- Adhkar the user wrote
-- ---------------------------------------------------------------------------

-- Newest first. A collection is listed in the order the user arranged it in;
-- a dhikr they wrote has no arrangement, and the one they are looking for is
-- overwhelmingly the one they just made.
activeUserAdhkar:
    SELECT * FROM user_adhkar
    WHERE deleted_at IS NULL
    ORDER BY created_at DESC, id;

activeUserDhikr:
    SELECT * FROM user_adhkar WHERE id = :id AND deleted_at IS NULL;

-- The batched fetch collection resolution runs for the 'user_dhikr' items of
-- one collection, mirroring `adhkarByIds` against content.db.
--
-- Soft-deleted rows are excluded, so an item pointing at a deleted dhikr
-- resolves to nothing and is reported as unresolved. That should be
-- unreachable — deleting a dhikr takes its items with it — and is the honest
-- answer if it ever is not.
userAdhkarByIds:
    SELECT * FROM user_adhkar WHERE id IN :ids AND deleted_at IS NULL;

insertUserDhikr:
    INSERT INTO user_adhkar
        (id, text_arabic, translation, transliteration, default_count,
         reference, notes, created_at, updated_at, deleted_at)
    VALUES (:id, :textArabic, :translation, :transliteration, :defaultCount,
            :reference, :notes, :createdAt, :updatedAt, NULL);

-- Every field at once, for the same reason `updateUserCollectionDetails`
-- writes name and description together: the form asks all of them at once, and
-- a half-applied answer is worse than a refused one. A null clears the field.
updateUserDhikr:
    UPDATE user_adhkar
    SET text_arabic = :textArabic,
        translation = :translation,
        transliteration = :transliteration,
        default_count = :defaultCount,
        reference = :reference,
        notes = :notes,
        updated_at = :updatedAt
    WHERE id = :id AND deleted_at IS NULL;

softDeleteUserDhikr:
    UPDATE user_adhkar
    SET deleted_at = :deletedAt, updated_at = :deletedAt
    WHERE id = :id AND deleted_at IS NULL;

-- The collections that hold one dhikr, for the sentence its delete
-- confirmation is built from and the count its row shows.
--
-- DISTINCT because one collection can say the same dhikr twice, and it is one
-- collection either way. Soft-deleted collections are left out: they are not
-- somewhere a deletion has to warn about.
collectionsUsingUserDhikr:
    SELECT DISTINCT c.* FROM user_collections c
    INNER JOIN user_collection_items i ON i.collection_id = c.id
    WHERE i.item_type = 'user_dhikr' AND i.user_item_id = :dhikr
      AND c.deleted_at IS NULL
    ORDER BY c.sort_order, c.created_at, c.id;

-- How many items point at each dhikr the user wrote, in one read.
--
-- The list screen shows a count per row, and asking per row would be one
-- statement per dhikr. Counts items and not collections: a collection that
-- says the same dhikr twice holds two items, which is what "taking it out"
-- will remove.
userDhikrUsageCounts:
    SELECT i.user_item_id AS dhikr, COUNT(*) AS uses
    FROM user_collection_items i
    INNER JOIN user_collections c ON c.id = i.collection_id
    WHERE i.item_type = 'user_dhikr' AND i.user_item_id IS NOT NULL
      AND c.deleted_at IS NULL
    GROUP BY i.user_item_id;

-- Takes a deleted dhikr out of every collection that held it.
--
-- Hard delete, where the dhikr itself is only soft-deleted: an item is a
-- position in a list, and a tombstoned one would leave a hole that
-- `setRepeatGroup`'s contiguity check trips over. The collections it touched
-- are renumbered afterwards, in the same transaction.
deleteItemsForUserDhikr:
    DELETE FROM user_collection_items
    WHERE item_type = 'user_dhikr' AND user_item_id = :dhikr;

-- ---------------------------------------------------------------------------
-- Progress and completions
-- ---------------------------------------------------------------------------

progressFor: SELECT * FROM progress WHERE collection_ref = :ref;

upsertProgress:
    INSERT INTO progress
        (collection_ref, step_index, step_ref, current_count, unit_index,
         updated_at)
    VALUES (:ref, :stepIndex, :stepRef, :currentCount, :unitIndex, :updatedAt)
    ON CONFLICT (collection_ref) DO UPDATE SET
        step_index = excluded.step_index,
        step_ref = excluded.step_ref,
        current_count = excluded.current_count,
        unit_index = excluded.unit_index,
        updated_at = excluded.updated_at;

deleteProgress: DELETE FROM progress WHERE collection_ref = :ref;

-- Two completions on the same local day count once: the unique index absorbs
-- the second, keeping the earlier completed_at.
logCompletion:
    INSERT INTO completions (id, collection_ref, date_key, completed_at)
    VALUES (:id, :ref, :dateKey, :completedAt)
    ON CONFLICT (collection_ref, date_key) DO NOTHING;

completionExists:
    SELECT EXISTS(
        SELECT 1 FROM completions
        WHERE collection_ref = :ref AND date_key = :dateKey
    ) AS v;

-- date_key is YYYY-MM-DD, so lexicographic bounds are chronological bounds.
completionDatesBetween:
    SELECT DISTINCT date_key FROM completions
    WHERE date_key >= :from AND date_key <= :to
    ORDER BY date_key;

completionDatesDescending:
    SELECT DISTINCT date_key FROM completions ORDER BY date_key DESC;

-- The same window as completionDatesBetween, for one collection: what the
-- home card's week strip is drawn from. No DISTINCT — idx_completions_ref_date
-- is unique on (collection_ref, date_key), so a day appears at most once, and
-- that index covers this query exactly.
-- One collection's whole history, newest first: what its own streak is walked
-- back through, the way completionDatesDescending serves the app-wide one.
collectionCompletionDatesDescending:
    SELECT date_key FROM completions
    WHERE collection_ref = :ref ORDER BY date_key DESC;

collectionCompletionDatesBetween:
    SELECT date_key FROM completions
    WHERE collection_ref = :ref AND date_key >= :from AND date_key <= :to
    ORDER BY date_key;

-- Which collections have ever been completed, for the tracker's scope picker.
-- One index scan rather than a completionDatesFor per collection, and it reads
-- refs rather than days: the picker only needs to know there is a history to
-- show, not what is in it. A ref here may no longer resolve — completions for
-- a deleted collection are kept deliberately — so the caller intersects this
-- against the collections that still exist.
completedCollectionRefs:
    SELECT DISTINCT collection_ref FROM completions;

-- ---------------------------------------------------------------------------
-- Reading position and settings
-- ---------------------------------------------------------------------------

-- Named around the table accessor drift generates for
-- `reading_position`, which already owns the name `readingPosition`.
currentReadingPosition: SELECT * FROM reading_position WHERE id = 1;

upsertReadingPosition:
    INSERT INTO reading_position (id, surah_number, ayah_number, updated_at)
    VALUES (1, :surahNumber, :ayahNumber, :updatedAt)
    ON CONFLICT (id) DO UPDATE SET
        surah_number = excluded.surah_number,
        ayah_number = excluded.ayah_number,
        updated_at = excluded.updated_at;

settingValue: SELECT value FROM settings WHERE "key" = :key;

upsertSetting:
    INSERT INTO settings ("key", value, updated_at)
    VALUES (:key, :value, :updatedAt)
    ON CONFLICT ("key") DO UPDATE SET
        value = excluded.value,
        updated_at = excluded.updated_at;

-- ---------------------------------------------------------------------------
-- Commitments
-- ---------------------------------------------------------------------------

-- What the user has committed to doing, and when in the day. This is what the
-- home screen shows; a collection that is not committed is still in the
-- collections list, it just does not appear on Home.
--
-- collection_ref is CollectionId.canonical, so a built-in and a user
-- collection are committed the same way, as everywhere else in this file.
--
-- collection_ref is the primary key rather than a plain column: a collection
-- is committed to one part of the day or to none. Committing it to a second
-- section is moving it, not adding it, and the upsert says so.
--
-- section is 'today' | 'morning' | 'evening'. Stored as a string rather than
-- an ordinal so a database opened by hand reads as what it is, and so
-- inserting a fourth section later cannot silently renumber the three.
--
-- days is a seven-bit mask of the days of the week the commitment falls on:
-- bit 0 Monday through bit 6 Sunday, so 127 is every day and 16 is Friday
-- alone. A mask rather than a child table because a commitment is one row and
-- a set of at most seven flags is not a relation worth joining; 127 is the
-- default because that is what almost every commitment is.
CREATE TABLE commitments (
    collection_ref TEXT    NOT NULL PRIMARY KEY,
    section        TEXT    NOT NULL,
    days           INTEGER NOT NULL DEFAULT 127,
    sort_order     INTEGER NOT NULL,
    created_at     INTEGER NOT NULL,
    updated_at     INTEGER NOT NULL
) AS CommitmentRow;

CREATE INDEX IF NOT EXISTS idx_commitments_section ON commitments (section, sort_order);

-- Ordered the way the tiles are laid out: the order they were committed in,
-- which is what sort_order records. Nothing reorders itself as the day goes on.
allCommitments:
    SELECT * FROM commitments ORDER BY sort_order, created_at, collection_ref;

nextCommitmentSortOrder:
    SELECT COALESCE(MAX(sort_order), 0) + 1 AS v FROM commitments;

-- Moving a collection to another section keeps its sort_order and its
-- created_at: it is the same commitment, in a different part of the day, and
-- it should not jump to the end of the grid for having been moved.
upsertCommitment:
    INSERT INTO commitments
        (collection_ref, section, days, sort_order, created_at, updated_at)
    VALUES (:ref, :section, :days, :sortOrder, :createdAt, :updatedAt)
    ON CONFLICT (collection_ref) DO UPDATE SET
        section = excluded.section,
        days = excluded.days,
        updated_at = excluded.updated_at;

deleteCommitment: DELETE FROM commitments WHERE collection_ref = :ref;
