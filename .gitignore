# Python
__pycache__/
*.pyc
.venv/

# Build output
build/
content/build/

# macOS
.DS_Store

# Quran source data.
# The normalised JSON (surahs.json, ayahs.json) is committed — see the
# exceptions below — so a fresh clone can build the database. The raw QUL
# exports it is generated from go in content/sources/quran/downloads/ and stay
# out: they are bulky and only needed to regenerate.
# See content/sources/quran/README.md.
content/sources/quran/*
!content/sources/quran/README.md
!content/sources/quran/ENCODING_REPORT.md
!content/sources/quran/ayahs.json
!content/sources/quran/surahs.json

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# The bundled copy of content.db. Generated by tool/sync_content_asset.sh from
# content/build/content.db, which is itself a build artifact: several megabytes,
# reproducible from content/sources/ at any time.
assets/content.db
