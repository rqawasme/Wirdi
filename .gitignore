# Python
__pycache__/
*.pyc
.venv/

# Build output
build/
content/build/

# macOS
.DS_Store

# Quran source data.
# Quran text and translations are licensed works. They are NOT redistributed
# through this repository; each person who builds the database downloads them
# from QUL themselves into content/sources/quran/downloads/. Everything else
# under content/sources/quran/ is generated by content/scripts/import_quran.py
# from those downloads — see content/sources/quran/README.md.
content/sources/quran/*
!content/sources/quran/README.md
!content/sources/quran/ENCODING_REPORT.md
!content/sources/quran/ayahs.json
!content/sources/quran/surahs.json

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# The bundled copy of content.db. Generated by tool/sync_content_asset.sh from
# content/build/content.db, which is itself built, not committed — the Quran
# text and translation in it are licensed works this repository does not
# redistribute.
assets/content.db
